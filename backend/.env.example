# Copy to backend/.env. All settings are optional: FLAMEPRINT runs fully offline without them.

# Groq (SI briefs, archive Q&A, document extraction). Without it, the deterministic writer is used.
GROQ_API_KEY=
# FLAMEPRINT_MODEL=openai/gpt-oss-120b
FLAMEPRINT_LLM=auto        # auto | on | off

# PostgreSQL + pgvector (docker compose up -d db). Without it, an in-memory index is used.
# DATABASE_URL=postgresql://flameprint:flameprint@localhost:5432/flameprint

# CORS_ORIGINS=http://localhost:3000
# FLAMEPRINT_DATA_DIR=../data
