# ───────── secrets & credentials (never commit) ─────────
.env
.env.*
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*credentials*
*secret*
!**/*secret*.md
service-account*.json
.netrc
.npmrc
.pypirc

# ───────── python ─────────
.venv/
venv/
env/
**/.venv/
**/venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# ───────── node / next ─────────
node_modules/
**/node_modules/
.next/
**/.next/
out/
build/
dist/
coverage/
*.tsbuildinfo
.vercel/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ───────── uploaded data (keep the folder, not the files) ─────────
data/imported/*
!data/imported/.gitkeep

# ───────── OS / editor / tooling ─────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.log
.claude/
